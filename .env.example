# All values are optional. The app runs on Arc Testnet only.
# Milestone escrow contract address on Arc Testnet. Leave empty until it is deployed.
VITE_ESCROW_ADDRESS=
# P2P (USDC to local currency) contract address on Arc Testnet. Leave empty until it is deployed.
VITE_P2P_ADDRESS=

# Contract deployment (Hardhat, scripts only; never exposed to the browser, so no VITE_ prefix).
# Testnet-only deployer key. NEVER commit .env.
PRIVATE_KEY=
# Address that resolves disputes in Escrow and P2P (the owner can change it later).
ARBITER_ADDRESS=
# Optional: contract owner (defaults to the deployer), token overrides, RPC override.
OWNER_ADDRESS=
USDC_ADDRESS=
EURC_ADDRESS=
ARC_TESTNET_RPC_URL=

# AI assistant (server-side only, never prefixed with VITE_). Without AI_API_KEY the assistant uses its built-in guide.
AI_API_KEY=
# Optional: any OpenAI-compatible chat completions endpoint and model.
AI_API_URL=
AI_MODEL=

# Swap with Circle App Kit (the default route) needs no key and no variable: it runs in the browser with the user's wallet.
#
# Swap (Circle StableFX route, optional). Server-side only, never prefixed with VITE_.
# Format: TEST_API_KEY:<id>:<secret>  (a StableFX "Read and write" key from the Circle Hub sandbox).
# LIVE keys are refused: this app is testnet-only. Without a key the Swap page shows that swaps are not enabled yet.
STABLEFX_API_KEY=
# Optional. Only "sandbox" is accepted (Arc Testnet).
STABLEFX_ENV=
